{
  // The public site. Requests are served from the static files, except "/" and "/lang/*", which run
  // worker/index.ts to pick the visitor's language.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "wic-www",
  "compatibility_date": "2026-11-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/lang/*"],
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "workers-intelligence-commons.org", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}

---
import { SectionHeading } from "@workers-intelligence-commons/components";
import PageHeading from "../../components/PageHeading.astro";
import Base from "../../layouts/Base.astro";
import type { Locale } from "../../i18n/locales.ts";
import { localePaths } from "../../i18n/routes.ts";
import { mission } from "../../copy/mission.ts";

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const t = mission[locale];
---
<Base locale={locale} page="mission" title={t.title} description={t.description}>
  <PageHeading kicker={t.kicker} title={t.title} />
  <p class="lead">{t.lead}</p>
  {t.principles.map((p) => (
    <section>
      <SectionHeading kicker={p.kicker}>{p.heading}</SectionHeading>
      {p.paragraphs.map((text) => <p set:html={text} />)}
    </section>
  ))}
</Base>

---
import { ButtonLink, PageTitle, SectionHeading } from "@workers-intelligence-commons/components";
import Base from "../../layouts/Base.astro";
import type { Locale } from "../../i18n/locales.ts";
import { localePaths, pathFor } from "../../i18n/routes.ts";
import { mission } from "../../copy/mission.ts";

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const t = mission[locale];
---
<Base locale={locale} page="mission" title={t.title} description={t.description}>
  <PageTitle>{t.title}</PageTitle>
  <p class="lead">{t.lead}</p>
  <div class="numbered">
  {t.principles.map((p) => (
    <section>
      <SectionHeading kicker={p.kicker}>{p.heading}</SectionHeading>
      {p.paragraphs.map((text) => <p set:html={text} />)}
    </section>
  ))}
  </div>

  <section>
    <p>{t.critiques.body}</p>
    <div class="actions"><ButtonLink variant="ink" href={pathFor(locale, "criticism")}>{t.critiques.link}</ButtonLink></div>
  </section>
</Base>

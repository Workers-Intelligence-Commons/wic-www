---
import { PageTitle } from "@workers-intelligence-commons/components";
import Base from "../../layouts/Base.astro";
import type { Locale } from "../../i18n/locales.ts";
import { localePaths } from "../../i18n/routes.ts";
import { legal } from "../../copy/legal.ts";

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const t = legal[locale];
---
<Base locale={locale} page="legal" title={t.title} description={t.description}>
  <PageTitle>{t.title}</PageTitle>
  <div class="prose">
    {t.blocks.map((b) => (
      <section class="section">
        <h2>{b.heading}</h2>
        {b.paragraphs.map((text) => <p set:html={text} />)}
      </section>
    ))}
  </div>
</Base>

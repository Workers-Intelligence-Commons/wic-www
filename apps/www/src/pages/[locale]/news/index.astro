---
import { PageTitle } from "@workers-intelligence-commons/components";
import Base from "../../../layouts/Base.astro";
import type { Locale } from "../../../i18n/locales.ts";
import { postsIn, slugOf } from "../../../i18n/news.ts";
import { localePaths, pathFor } from "../../../i18n/routes.ts";
import { news } from "../../../copy/news.ts";

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const t = news[locale];
const posts = await postsIn(locale);
const date = new Intl.DateTimeFormat(locale, t.dateFormat);
---
<Base locale={locale} page="news" title={t.title} description={t.description}>
  <PageTitle>{t.title}</PageTitle>
  <p class="lead">{t.lead}</p>
  {posts.length === 0 ? <p class="empty">{t.empty}</p> : (
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <h2><a href={pathFor(locale, `news/${slugOf(post)}`)}>{post.data.title}</a></h2>
          <time class="aside" datetime={post.data.date.toISOString().slice(0, 10)}>{date.format(post.data.date)}</time>
          <p>{post.data.description}</p>
        </li>
      ))}
    </ul>
  )}
  <p class="section"><a href={pathFor(locale, "news") + "rss.xml"}>{t.rss}</a></p>
</Base>

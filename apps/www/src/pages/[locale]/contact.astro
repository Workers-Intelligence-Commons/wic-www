---
import { PageTitle } from "@workers-intelligence-commons/components";
import Base from "../../layouts/Base.astro";
import type { Locale } from "../../i18n/locales.ts";
import { localePaths } from "../../i18n/routes.ts";
import { contact } from "../../copy/contact.ts";

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const t = contact[locale];
---
<Base locale={locale} page="contact" title={t.title} description={t.description}>
  <PageTitle>{t.title}</PageTitle>
  <p class="lead">{t.lead}</p>
  <table class="ledger">
    <tbody>
      {t.rows.map((r) => <tr><th scope="row">{r.label}</th><td set:html={r.value} /></tr>)}
    </tbody>
  </table>
  <p>{t.note}</p>
</Base>

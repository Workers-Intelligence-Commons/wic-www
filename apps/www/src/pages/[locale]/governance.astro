---
import { ButtonLink, Notice, PageTitle, SectionHeading } from "@workers-intelligence-commons/components";
import Base from "../../layouts/Base.astro";
import type { Locale } from "../../i18n/locales.ts";
import { localePaths, pathFor } from "../../i18n/routes.ts";
import { governance } from "../../copy/governance.ts";

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const t = governance[locale];
---
<Base locale={locale} page="governance" title={t.title} description={t.description}>
  <PageTitle>{t.title}</PageTitle>
  <div class="opening">
    <p class="lead">{t.lead}</p>
    <div class="notice-row"><Notice title={t.statusTitle}>{t.status}</Notice></div>
  </div>
  <div class="actions"><ButtonLink variant="primary" href={pathFor(locale, "constitution")}>{t.constitutionLink}</ButtonLink></div>
  {t.blocks.map((b) => (
    <section>
      <SectionHeading>{b.heading}</SectionHeading>
      {b.paragraphs.map((text) => <p>{text}</p>)}
    </section>
  ))}
</Base>

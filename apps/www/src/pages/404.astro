---
import { ButtonLink, PageTitle, SectionHeading } from "@workers-intelligence-commons/components";
import Base from "../layouts/Base.astro";
import { pathFor } from "../i18n/routes.ts";
import { ui } from "../copy/ui.ts";

const t = ui.en.notFound;
const fr = ui.fr.notFound;
---
<Base locale="en" page="404" title={t.title} description={t.description} alternates={[]} noindex>
  <PageTitle kicker="404">{t.heading}</PageTitle>
  <p>{t.body}</p>
  <div class="actions"><ButtonLink variant="ink" href={pathFor("en")}>{t.back}</ButtonLink></div>
  <section lang="fr">
    <SectionHeading>{fr.heading}</SectionHeading>
    <p>{fr.body}</p>
    <div class="actions"><ButtonLink variant="quiet" href={pathFor("fr")}>{fr.back}</ButtonLink></div>
  </section>
</Base>

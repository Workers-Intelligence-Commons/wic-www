---
// Everything a search engine or a link preview reads from <head>: title, description, canonical URL,
// the same page in other languages, Open Graph and structured data.
import { type Locale, localeTags, locales } from "../i18n/locales.ts";
import { pathFor } from "../i18n/routes.ts";
import { site } from "../data/site.ts";

interface Props {
  locale: Locale;
  /** The page key used by pathFor; "" for home. */
  page: string;
  title: string;
  description: string;
  type?: "website" | "article";
  published?: Date;
  /** Locales that have this page; every locale by default. */
  alternates?: readonly Locale[];
  jsonLd?: Record<string, unknown>[];
  /** Keeps the page out of search results, for pages such as the 404. */
  noindex?: boolean;
}

const { locale, page, title, description, type = "website", published, alternates = locales, jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(pathFor(locale, page), site.url).href;
const fullTitle = page === "" ? `${site.name}: ${title}` : `${title} · ${site.name}`;
const image = new URL("/og.png", site.url).href;
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
{alternates.map((l) => <link rel="alternate" hreflang={localeTags[l].lang} href={new URL(pathFor(l, page), site.url).href} />)}
{alternates.includes("en") && <link rel="alternate" hreflang="x-default" href={new URL(pathFor("en", page), site.url).href} />}
<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={site.name} />
<meta property="og:locale" content={localeTags[locale].og} />
{alternates.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={localeTags[l].og} />)}
{published && <meta property="article:published_time" content={published.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<link rel="alternate" type="application/rss+xml" title={`${site.name} (${localeTags[locale].lang})`} href={pathFor(locale, "news") + "rss.xml"} />
{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
